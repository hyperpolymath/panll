# SPDX-License-Identifier: PMPL-1.0-or-later

# Normalize text files to LF by default
* text=auto eol=lf

# Source code
*.rs text diff=rust
*.ex text diff=elixir
*.exs text diff=elixir
*.res text diff=javascript
*.resi text diff=javascript
*.js text diff=javascript
*.ts text diff=typescript
*.proto text
*.graphql text
*.gql text
*.sh text

# Config + docs
*.toml text
*.json text
*.yml text
*.yaml text
*.md text diff=markdown
*.adoc text
*.ncl text
*.scm text linguist-language=Scheme

# Binary artifacts
*.wasm binary
*.beam binary
*.so binary
*.dylib binary
*.dll binary
*.exe binary
*.png binary
*.ico binary
*.icns binary
*.ctp binary

# Generated files
*.res.js linguist-generated=true
*.resi.js linguist-generated=true
lib/bs/** linguist-generated=true
deno.lock linguist-generated=true
package-lock.json linguist-generated=true
src-tauri/Cargo.lock linguist-generated=true
**/mix.lock linguist-generated=true
