// ===========================================================================
// Combined Catalog
// ===========================================================================

/// The full catalog of all 108 proven-servers components, merged from all categories.
/// This is loaded once into vabState.catalog at init time.
let allComponents: array<vabComponent> = Array.flat([
  coreComponents,
  networkComponents,
  dnsComponents,
  webComponents,
  iotComponents,
  emailComponents,
  securityComponents,
  dataComponents,
  applicationComponents,
  infrastructureComponents,
  connectorComponents,
])

/// Get all components for a specific category.
let getByCategory = (catalog: array<vabComponent>, cat: vabCategory): array<vabComponent> =>
  Array.filter(catalog, c => c.category === cat)

/// Find a component by its ID.
let findById = (catalog: array<vabComponent>, id: string): option<vabComponent> =>
  Array.find(catalog, c => c.id === id)

/// Get category display name for the sidebar.
let categoryName = (cat: vabCategory): string =>
  switch cat {
  | VabCore => "Core"
  | VabNetwork => "Network"
  | VabDns => "DNS"
  | VabWeb => "Web"
  | VabIot => "IoT"
  | VabEmail => "Email"
  | VabSecurity => "Security"
  | VabData => "Data"
  | VabApplication => "App"
  | VabInfrastructure => "Infra"
  | VabConnectors => "Conn"
  }

/// Get category icon character for the sidebar (single-char abbreviations).
let categoryIcon = (cat: vabCategory): string =>
  switch cat {
  | VabCore => "C"
  | VabNetwork => "N"
  | VabDns => "D"
  | VabWeb => "W"
  | VabIot => "I"
  | VabEmail => "E"
  | VabSecurity => "S"
  | VabData => "Dt"
  | VabApplication => "A"
  | VabInfrastructure => "If"
  | VabConnectors => "Cn"
  }
