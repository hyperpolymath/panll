#
# Generic Inspector Clade Template
# Inspectors browse and explore internal structures — clades, traits, metadata, taxonomies.

[clade-metadata]
id = "{{CLADE_ID}}"
name = "{{CLADE_NAME}}"
short-name = "{{SHORT}}"
version = "0.1.0"
kind = "inspector"
icon = "{{ICON}}"
description = "{{ONE_LINE_DESCRIPTION}}"

[clade-traits]
# Inspectors are read-only explorers of internal system state.
has-backend = false          # Often client-side only (override if querying backend)
has-scanning = false
has-persistence = false      # Inspectors view live state, not persisted data
has-work-items = false
has-priority-ordering = false
has-customisation = true     # Display options, filters, grouping
is-directive = false
is-readonly = true           # REQUIRED: inspectors only read, never modify

[clade-capabilities]
# Minimum capabilities for an inspector clade.
capabilities = [
  "StructureBrowsing",       # Browse hierarchical structures
  "DetailInspection",        # View detailed properties of items
  "SearchFilter",            # Search and filter inspected data
  "MetadataDisplay",         # Show metadata, traits, attributes
]

[clade-connections]
backend-type = "none"
protocols = []

[clade-accessibility]
keyboard-navigable = true
screen-reader-support = true
aria-roles = ["tree", "treeitem", "table", "grid"]

[clade-integration-hooks]
on-init = "{{ON_INIT_HANDLER}}"
on-dispose = "{{ON_DISPOSE_HANDLER}}"

[clade-panel-integration]
panel-id = "Panel{{PASCAL_NAME}}"
model-module = "{{PASCAL_NAME}}Model"
component-module = "{{PASCAL_NAME}}"
command-module = "{{PASCAL_NAME}}Cmd"
