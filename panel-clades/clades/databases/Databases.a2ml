# Databases Panel Clade — VeriSimDB, QuandleDB, LithoGlyph Management

[clade-metadata]
id = "databases"
name = "Databases"
short-name = "DB"
version = "1.0.0"
kind = "database"
icon = "database"
description = "VeriSimDB, QuandleDB, LithoGlyph management — query, browse, octad inspection."

[clade-traits]
has-backend = true
has-scanning = false
has-persistence = true
has-work-items = false
has-priority-ordering = false
has-customisation = true
is-directive = false
is-readonly = false

[clade-capabilities]
capabilities = [
  "VeriSimDBQueries",
  "QuandleDBQueries",
  "LithoGlyphQueries",
  "OctadInspection",
  "SchemaExploration",
]

[clade-panel-integration]
panel-id = "PanelDatabases"
model-module = "DatabasesModel"
component-module = "Databases"
