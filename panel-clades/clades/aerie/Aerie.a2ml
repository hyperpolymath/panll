#
# Aerie Panel Clade — Network Diagnostics and BGP Forensics

[clade-metadata]
id = "aerie"
name = "Aerie"
short-name = "Net"
version = "1.0.0"
kind = "network"
icon = "network"
description = "Network diagnostics and BGP forensics — traceroute, latency, packet analysis."

[clade-traits]
has-backend = true           # Network probing via Tauri backend
has-scanning = true          # Probes network paths, measures latency
has-persistence = true       # Saves diagnostic results
has-work-items = true        # Network issues as TSDM work items
has-priority-ordering = false
has-customisation = true     # Target host, probe count, protocol selection
is-directive = false
is-readonly = false

[clade-capabilities]
capabilities = [
  "Traceroute",              # Hop-by-hop network path visualisation
  "LatencyMeasurement",      # Round-trip time and jitter analysis
  "PacketLossDetection",     # Identify lossy network segments
  "BGPForensics",            # BGP route analysis and anomaly detection
  "DNSProbing",              # DNS resolution diagnostics
  "ProofEnvelopeInspection", # SHA-256/Ed448 proof verification
  "VeriSimDBTemporal",       # Bitemporal audit queries
  "ContainerOrchestration",  # Podman Compose 6-service management
  "NetworkSimulation",       # Latency injection, route injection
  "CollaborativeMode",       # Parent+child shared sessions
]

[clade-ensaid]
# eNSAID panel suite for Aerie development (designed 2026-03-08)
design-doc = "AERIE-ENSAID-DESIGN.md"
panel-count = 13
must-panels = ["valence-shell", "network-topology", "probe-dashboard", "proof-inspector"]
should-panels = ["abi-ffi-workbench", "api-explorer", "watcher", "container-orchestrator"]
could-panels = ["simulation", "capture-share", "boj-monitor", "panic-attack"]
corrective-panels = ["verisimdb-explorer"]

[clade-integrations]
boj-cartridges = ["observe-mcp", "database-mcp", "nesy-mcp", "proof-mcp"]
echidna = true
typell = true
panic-attack = true
verisimdb = true
proven-servers = true

[clade-panel-integration]
panel-id = "PanelAerie"
model-module = "AerieModel"
component-module = "Aerie"
command-module = "AerieCmd"
module-module = "AerieModule"
