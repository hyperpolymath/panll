# Level Architect Panel Clade — Visual level design for IDApTIK

[clade-metadata]
id = "level-architect"
name = "Level Architect"
short-name = "Lvl"
version = "1.0.0"
kind = "builder"
icon = "map"
description = "Visual level design tool — device placement, guard patrols, defence flags, asset browser, level validation, and LevelConfig.res export."

[clade-traits]
has-backend = true
has-scanning = false
has-persistence = true
has-work-items = false
has-priority-ordering = false
has-customisation = true
is-directive = false
is-readonly = false

[clade-capabilities]
capabilities = [
  "DevicePlacement",
  "GuardPatrolEditor",
  "SpawnPointConfig",
  "DefenceFlagToggles",
  "AlertThresholdSliders",
  "AssetBrowser",
  "LevelValidation",
  "CompanionPlacement",
  "LevelExport",
  "LevelImport",
  "UndoRedo",
  "SideBySidePreview",
]

[clade-panel-integration]
panel-id = "PanelLevelArchitect"
model-module = "LevelArchitectModel"
component-module = "LevelArchitect"
command-module = "LevelArchitectCmd"

[clade-dependencies]
level-config = "src/app/screens/LevelConfig.res"
defence-flags = 11
ums-integration = "idaptik-ums"
