# Device Network Designer Panel Clade — Visual designer for IDApTIK in-game networks

[clade-metadata]
id = "device-network-designer"
name = "Device Network Designer"
short-name = "NetDes"
version = "0.1.0"
kind = "builder"
icon = "network"
description = "Visual designer for IDApTIK in-game device networks — drag-and-drop device placement, cable routing, protocol assignment, and topology validation."

[clade-traits]
has-backend = true
has-scanning = false
has-persistence = true
has-work-items = false
has-priority-ordering = false
has-customisation = true
is-directive = false
is-readonly = false

[clade-capabilities]
capabilities = [
  "DragDropDevices",
  "CableRouting",
  "ProtocolAssignment",
  "TopologyValidation",
  "DeviceCatalogue",
  "SubnetDesign",
  "ExportTopology",
  "SimulateTraffic",
]

[clade-panel-integration]
panel-id = "PanelDeviceNetworkDesigner"
model-module = "DeviceNetworkDesignerModel"
component-module = "DeviceNetworkDesigner"
command-module = "DeviceNetworkDesignerCmd"

[clade-cross-panel]
depends-on = ["network-topology", "level-architect"]
feeds-into = ["game-preview", "multiplayer-monitor"]
