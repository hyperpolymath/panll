;
; Clade manifest for the Language Forge panel.

(clade
  (id "language-forge")
  (name "Language Forge")
  (kind "viewer")
  (parent "viewer")
  (description "Monitor and develop the 14 nextgen-languages portfolio — scores, phases, WASM readiness")
  (traits
    (has-backend false)
    (has-persistence false)
    (has-customisation false)
    (is-readonly true))
  (capabilities
    (HealthCheck "Basic health check endpoint"))
  (integrations
    (model "LanguageForgeModel")
    (component "LanguageForge")
    (engine "LanguageForgeEngine")))
