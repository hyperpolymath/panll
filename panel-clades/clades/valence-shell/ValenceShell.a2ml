# Valence Shell Panel Clade — Embedded terminal with Claude Code integration

[clade-metadata]
id = "valence-shell"
name = "Valence Shell"
short-name = "VS"
version = "1.0.0"
kind = "terminal"
icon = "terminal-square"
description = "Embedded Valence shell with Claude Code, session recording, reversible filesystem ops, and collaborative approval gate."

[clade-traits]
has-backend = true
has-scanning = false
has-persistence = true
has-work-items = false
has-priority-ordering = false
has-customisation = true
is-directive = false
is-readonly = false

[clade-capabilities]
capabilities = [
  "PTYTerminal",
  "ClaudeCodeIntegration",
  "SessionRecording",
  "ReversibleFilesystemOps",
  "ApprovalGate",
  "CommandPalette",
  "AlkahestTransmuter",
  "SharedSession",
]

[clade-panel-integration]
panel-id = "PanelValenceShell"
model-module = "ValenceShellModel"
component-module = "ValenceShell"
command-module = "ValenceShellCmd"

[clade-dependencies]
external-binary = "valence-shell"
tauri-plugin = "@tauri-apps/plugin-shell"
terminal-emulator = "xterm.js"
