#
# Mass Panic Panel Clade — Organisation-Scale Batch Scanning

[clade-metadata]
id = "mass-panic"
name = "Mass Panic"
short-name = "MP"
version = "2.1.0"
kind = "scanner"
icon = "zap-off"
description = "Organisation-scale batch scanning — assemblyline + BLAKE3 + imaging + temporal + verisimdb."

[clade-traits]
has-backend = true           # Invokes panic-attack assemblyline via Tauri
has-scanning = true          # Core trait: batch scans entire repo directories
has-persistence = true       # verisimdb octad persistence + BLAKE3 cache
has-work-items = true        # Aggregate findings feed into TSDM
has-priority-ordering = false
has-customisation = true     # Incremental mode, notification, filter, sort
is-directive = false
is-readonly = false

[clade-capabilities]
capabilities = [
  "AssemblylineScanning",    # Parallel batch scanning across repos
  "IncrementalBlake3",       # BLAKE3 content fingerprinting for skip-unchanged
  "VerisimDBPersistence",    # Store results as verisimdb octads
  "DeltaReporting",          # Compare runs, show regressions/improvements
  "NotificationPipeline",    # Generate notifications for critical findings
  "RepoDiscovery",           # Auto-discover repos in a directory
  "CacheManagement",         # Manage incremental scan cache
  "SystemImaging",           # fNIRS-style spatial health mapping
  "TemporalNavigation",      # Time-series diff, trend detection, replay
]

[clade-panel-integration]
panel-id = "PanelMassPanic"
model-module = "MassPanicModel"
component-module = "MassPanic"
command-module = "MassPanicCmd"
module-module = "MassPanicModule"

[clade-related]
parent = "panic-attacker"
sibling = "panic-attack"
