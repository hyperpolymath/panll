#
# AI Panel Clade — Multi-Provider Neural Interface

[clade-metadata]
id = "ai"
name = "AI"
short-name = "AI"
version = "1.0.0"
kind = "ai"
icon = "brain-circuit"
description = "Multi-provider AI neural interface — Claude, Gemini, Mistral, GPT, local models."

[clade-traits]
has-backend = true
has-scanning = false
has-persistence = true
has-work-items = false
has-priority-ordering = false
has-customisation = true
is-directive = false
is-readonly = false

[clade-capabilities]
capabilities = [
  "MultiProviderChat",
  "BroadcastMode",
  "SystemPromptConfig",
  "ModelSelection",
  "ProviderHealthCheck",
  "ConversationHistory",
]

[clade-providers]
providers = ["claude", "gemini", "mistral", "gpt", "local"]

[clade-panel-integration]
panel-id = "PanelAi"
model-module = "AiModel"
component-module = "Ai"
command-module = "AiCmd"
module-module = "AiModule"
engine-module = "AiEngine"
