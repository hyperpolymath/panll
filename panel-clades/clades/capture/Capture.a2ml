#
# Capture Panel Clade — Screenshots, Recordings, Demos

[clade-metadata]
id = "capture"
name = "Capture"
short-name = "Cap"
version = "1.0.0"
kind = "viewer"
icon = "camera"
description = "Screenshots, recordings, demos, panel cloning, and comparison views."

[clade-traits]
has-backend = true
has-scanning = false
has-persistence = true
has-work-items = false
has-priority-ordering = false
has-customisation = true
is-directive = false
is-readonly = false

[clade-capabilities]
capabilities = [
  "ScreenCapture",
  "PanelCloning",
  "ComparisonView",
  "CaptureBar",
  "FileExport",
]

[clade-panel-integration]
panel-id = "PanelCapture"
model-module = "CaptureModel"
component-module = "Capture"
command-module = "CaptureCmd"
module-module = "CaptureModule"
