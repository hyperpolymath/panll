--
-- The panel-clades ABI modules, typechecked under Idris2 0.8.0 against
-- typed-wasm's grade kernel at the pin in scripts/fetch-siblings.sh.
-- Check with panel-clades/scripts/check-abi.sh.  Every module under
-- PanelClades/ is listed here; the check fails on an unlisted one.

package panelcladesgrades

sourcedir = "."

modules = PanelClades.ABI.Types
        , PanelClades.ABI.Layout
        , PanelClades.ABI.Foreign
        , PanelClades.ABI.Grades
