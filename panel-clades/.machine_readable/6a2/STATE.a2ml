# STATE.a2ml — Project state checkpoint for panel-clades

[metadata]
project = "panel-clades"
version = "0.2.0"
last-updated = "2026-03-03"
status = "active"

[project-context]
name = "panel-clades"
purpose = "Taxonomic registry of PanLL panel types — clade definitions, trait hierarchies, and directive panels. Each clade declares what a panel IS (capabilities, data shapes, interaction patterns) so panels can inherit behaviour and users can customise ordering/priority."
completion-percentage = 55

[position]
phase = "implementation"
maturity = "alpha"

[route-to-mvp]
milestones = [
  { name = "Phase 0: Repo scaffolding from RSR template", completion = 100 },
  { name = "Phase 1: TSDM directive clade (first clade)", completion = 100 },
  { name = "Phase 2: All 22 panel clade definitions", completion = 100 },
  { name = "Phase 3: Clade inheritance engine in PanLL", completion = 0 },
  { name = "Phase 4: User-facing clade browser panel", completion = 0 },
]

[completed-work]
items = [
  "TSDM directive clade — full a2ml + adoc + README",
  "22 panel clade a2ml definitions covering all PanLL panels",
  "22 clade README.adoc files",
  "Clades registry README with full kind taxonomy",
  "9 clade kinds defined: directive, scanner, builder, database, network, viewer, ai, loader, meta",
  "Clade trait schema: has-backend, has-scanning, has-persistence, has-work-items, has-priority-ordering, has-customisation, is-directive, is-readonly",
  "Panel integration metadata: panel-id, model-module, component-module, command-module, module-module, engine-module",
]

[blockers-and-issues]
# None

[critical-next-actions]
actions = [
  "Implement clade inheritance engine — panels inherit traits from clades at startup",
  "Create clade browser panel — UI for exploring and customising clades",
  "Wire clade traits into PanelRegistry for runtime capability queries",
  "Add clade-level permission system (which clades can cross-reference)",
]

[maintenance-status]
last-run-utc = "never"
last-report = "reports/maintenance/latest.json"
last-result = "unknown"
open-warnings = 0
open-failures = 0

[ecosystem]
part-of = ["PanLL", "RSR Framework"]
depends-on = ["panll", "panic-attack", "sustainabot"]
