# Auto-generated by: contractile gen-just
# Source directory: contractiles
# Re-generate with: contractile gen-just --dir contractiles
#
# SPDX-License-Identifier: MPL-2.0

# === DUST (Recovery & Rollback) ===
# Source: Dustfile.a2ml

# List available dust recovery actions
dust-status:
    @echo '  dust-source-rollback: Revert all source changes to last commit [rollback]'

# Revert all source changes to last commit
dust-source-rollback:
    @echo 'Executing rollback for source-rollback'
    git checkout HEAD -- .


# === INTEND (Declared Future Intent) ===
# Source: Intentfile.a2ml

# Display declared future intents
intend-list:
    @echo '=== Declared Intent ==='
    @echo ''
    @echo 'Core:'
    @echo ''
    @echo 'Integration:'
    @echo ''
    @echo 'Quality:'


# === MUST (Physical State Checks) ===
# Source: Mustfile.a2ml

# Run all must checks
must-check: must-license-present must-readme-present must-rescript-config must-app-entry must-model-entry must-safedom-enforcement must-no-deprecated-js-apis must-spdx-headers must-panels-not-panes must-no-dockerfile must-no-makefile must-no-env-files
    @echo 'All must checks passed'

# LICENSE file must exist
must-license-present:
    test -f LICENSE

# README must exist
must-readme-present:
    test -f README.adoc || test -f README.md

# rescript.json must exist
must-rescript-config:
    test -f rescript.json

# App.res entry point must exist
must-app-entry:
    test -f src/App.res

# Model.res must exist
must-model-entry:
    test -f src/Model.res

# SafeDOM Nickel enforcement config must exist
must-safedom-enforcement:
    test -f contractiles/safedom-enforcement.ncl

# No deprecated Js.* APIs
must-no-deprecated-js-apis:
    grep -rn 'Js\.\(Dict\|Array2\|String2\)' src/ --include='*.res' | wc -l | grep -q '^0$'

# ReScript source files should have SPDX headers
must-spdx-headers:
    find src/ -name '*.res' | head -20 | xargs -r grep -L 'SPDX-License-Identifier' | wc -l | grep -q '^0$'

# Code must use "panels" terminology, never "panes"
must-panels-not-panes:
    grep -rni 'pane[^l]' src/ --include='*.res' | grep -iv 'panel' | wc -l | grep -q '^0$'

# No Dockerfiles
must-no-dockerfile:
    test ! -f Dockerfile

# No Makefiles
must-no-makefile:
    test ! -f Makefile

# No .env files committed
must-no-env-files:
    test ! -f .env


# === TRUST (Integrity & Provenance Verification) ===
# Source: Trustfile.a2ml

# Run all trust verifications
trust-verify: trust-license-content trust-no-secrets-committed trust-container-images-pinned
    @echo 'All trust verifications passed'

# LICENSE contains expected SPDX identifier
trust-license-content:
    grep -q 'SPDX\|License\|MIT\|Apache\|PMPL\|MPL' LICENSE

# No .env or credential files in repo
trust-no-secrets-committed:
    test ! -f .env && test ! -f credentials.json && test ! -f .env.local

# Containerfile base images use pinned digests
trust-container-images-pinned:
    test ! -f Containerfile || grep -q '@sha256:' Containerfile


# === K9 Components ===

# K9 component: contractiles/safedom-enforcement.ncl
k9-safedom-enforcement:
    contractile k9 run contractiles/safedom-enforcement.ncl

