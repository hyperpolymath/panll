# RSR-compliant .gitignore
# SPDX-License-Identifier: PMPL-1.0-or-later

# ── Node + package managers ──────────────────────────────
node_modules/
.pnpm-store/

# ── Deno ─────────────────────────────────────────────────
.deno/

# ── ReScript (in-source mode) ────────────────────────────
lib/
lib/bs/
.merlin
.bsb.lock
*.res.js
*.resi.js
*.cmt
*.cmti
*.cmi

# ── Rust / Gossamer ──────────────────────────────────────
/target/
src-gossamer/target/
src-tauri/target/
src-tauri/WixTools/
src-tauri/Cargo.lock
/zig-out/
/zig-cache/

# ── BEAM / Elixir ───────────────────────────────────────
/_build/
beam/**/_build/
beam/**/deps/
beam/**/.elixir_ls/
beam/**/erl_crash.dump
/.elixir_ls/
/cover/
/doc/
*.ez
erl_crash.dump

# ── Frontend build artifacts ─────────────────────────────
public/styles.css
public/app.bundle.js
public/app.bundle.js.map
dist/
build/
out/

# ── PanLL integration artifacts ─────────────────────────
panic-attack-*.json
panll-event-chain-*.json
*.ctp
.panll/

# ── Test / Coverage ─────────────────────────────────────
coverage/
test-results/
playwright-report/
htmlcov/

# ── Julia ────────────────────────────────────────────────
*.jl.cov
*.jl.mem
/Manifest.toml

# ── Python (SaltStack only) ─────────────────────────────
__pycache__/
*.py[cod]
.venv/

# ── Ada / SPARK ──────────────────────────────────────────
*.ali
/obj/
/bin/

# ── Haskell ──────────────────────────────────────────────
/.stack-work/
/dist-newstyle/

# ── Chapel ───────────────────────────────────────────────
*.chpl.tmp.*

# ── Secrets ──────────────────────────────────────────────
.env
.env.*
.env.local
.env.*.local
runtime/.env
runtime/.env.*
*.pem
*.key
secrets/

# ── Logs ─────────────────────────────────────────────────
*.log
npm-debug.log*
/logs/

# ── OS & Editor ─────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.kate-swp
.idea/
.vscode/

# ── Hypatia scanning artifacts ──────────────────────────
.hypatia/

# ── Machine-readable locks ──────────────────────────────
.machine_readable/.locks/

# ── Temp ─────────────────────────────────────────────────
/tmp/
*.tmp
*.bak

# ── Dependencies ────────────────────────────────────────
/vendor/
/deps/

# asdf version manager
.tool-versions

# wokelangiser generated i18n locale files (too large for GitHub)
generated/wokelangiser/i18n/
target/
_build/
deps/
.elixir_ls/
.cache/
